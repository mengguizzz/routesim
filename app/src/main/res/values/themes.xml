<resources>
    <style name="Theme.Routesim" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">@color/route_primary</item>
        <item name="colorPrimaryVariant">@color/route_primary_dark</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorSecondary">@color/route_accent</item>
        <item name="colorSecondaryVariant">@color/route_accent</item>
        <item name="colorOnSecondary">@color/white</item>
        <item name="colorSurface">@color/route_surface</item>
        <item name="colorOnSurface">@color/route_ink</item>
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowActionModeOverlay">true</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowBackground">@color/route_surface</item>
        <item name="materialAlertDialogTheme">@style/ThemeOverlay.Routesim.AlertDialog</item>
    </style>

    <style name="ThemeOverlay.Routesim.AlertDialog"
        parent="ThemeOverlay.MaterialComponents.MaterialAlertDialog">
        <item name="colorPrimary">@color/route_primary</item>
        <item name="colorSurface">@color/route_surface</item>
        <item name="shapeAppearanceOverlay">@style/ShapeAppearance.Routesim.Dialog</item>
    </style>

    <style name="ShapeAppearance.Routesim.Dialog"
        parent="ShapeAppearance.MaterialComponents.MediumComponent">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">24dp</item>
    </style>

    <style name="Widget.Routesim.ModeButton"
        parent="Widget.MaterialComponents.Button.OutlinedButton">
        <item name="android:textSize">14sp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:minHeight">46dp</item>
        <item name="cornerRadius">14dp</item>
        <item name="strokeColor">@color/route_outline</item>
        <item name="strokeWidth">1dp</item>
    </style>

    <style name="Widget.Routesim.PrimaryButton"
        parent="Widget.MaterialComponents.Button">
        <item name="android:textSize">15sp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:minHeight">52dp</item>
        <item name="cornerRadius">16dp</item>
        <item name="backgroundTint">@color/route_primary</item>
        <item name="android:letterSpacing">0.01</item>
    </style>

    <style name="Widget.Routesim.MapToolButton"
        parent="Widget.MaterialComponents.Button.OutlinedButton">
        <item name="android:minWidth">48dp</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:padding">0dp</item>
        <item name="iconGravity">textStart</item>
        <item name="iconPadding">0dp</item>
        <item name="iconTint">@color/route_ink</item>
        <item name="backgroundTint">@color/route_map_tool</item>
        <item name="strokeColor">@color/route_outline</item>
        <item name="cornerRadius">15dp</item>
    </style>
</resources>
